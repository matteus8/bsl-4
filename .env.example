# ==============================================================================
# BSL-4: Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
#
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler URL (Port 5432)
# Format: jdbc:postgresql://[host]:5432/postgres?sslmode=require&prepareThreshold=0&connection_limit=1
SPRING_DATASOURCE_URL="jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0&connection_limit=1"
SPRING_DATASOURCE_USERNAME="postgres.your-project-ref"
SPRING_DATASOURCE_PASSWORD="your-supabase-db-password"

# Optional direct PostgreSQL connection URL for Python workers:
# DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AI Editorial Synthesis (Google Gemini)
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 3. External Public Hazard APIs
# ------------------------------------------------------------------------------
# NASA Open API Key (Sign up at https://api.nasa.gov/ for 1,000 req/hr; default: DEMO_KEY)
NASA_API_KEY="DEMO_KEY"

# National Weather Service (NWS) requires a descriptive User-Agent header with contact info
WEATHERGOV_USERAGENT="BSL4ProtocolZero/1.0 (contact@yourdomain.com)"

# ------------------------------------------------------------------------------
# 4. AWS Cloud Deployment & Static Edge Distribution
# ------------------------------------------------------------------------------
AWS_REGION="us-east-1"
S3_BUCKET_NAME="platformstaq.com"
CLOUDFRONT_DIST_ID="your-cloudfront-distribution-id"
WORKER_FUNCTION_NAME="bsl4-ingestor"
AI_WORKER_FUNCTION_NAME="bsl4-ai-editor"
LAMBDA_ROLE_NAME="bsl4-lambda-execution-role"

# ------------------------------------------------------------------------------
# 5. Frontend Configuration (Optional)
# ------------------------------------------------------------------------------
# Leave empty in production to fetch static S3/CloudFront edge JSON snapshots
# Set to "http://localhost:8080" for local development against a local mock server
NEXT_PUBLIC_API_URL=""
